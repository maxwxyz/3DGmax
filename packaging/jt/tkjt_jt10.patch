+// Copy of the GNU General Public License is in LICENSE.txt and  
+// on <http://www.gnu.org/licenses/>.
+
+#ifndef _JtDecode_Int32CDP_MoveToFront_HeaderFile
+#define _JtDecode_Int32CDP_MoveToFront_HeaderFile
+
+#include <JtDecode_Int32CDP.hxx>
+
+//! Move-to-Front pseudo-codec decoder (JT 10+): the data stream is split into
+//! "values" (each newly seen value) and "offsets" (position in a window of the
+//! most recently seen values, or an escape where a new value is taken).
+class JtDecode_Int32CDP_MoveToFront : public JtDecode_Int32CDP::EncodedData
+{
+public:
+  JtDecode_Int32CDP_MoveToFront (JtDecode_Int32CDP theValues,
+                                 JtDecode_Int32CDP theOffsets,
+                                 int32_t theCount)
+    : myValues (theValues), myOffsets (theOffsets), myCount (theCount) {}
+
+  Standard_EXPORT int32_t GetOutValCount() const Standard_OVERRIDE { return myCount; }
+
+  Standard_EXPORT Decoded::Mover Decode() Standard_OVERRIDE;
+
+private:
+  JtDecode_Int32CDP myValues;
+  JtDecode_Int32CDP myOffsets;
+  int32_t myCount;
+};
+
+#endif
