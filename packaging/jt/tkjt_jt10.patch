+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+// GNU General Public License for more details.
+// 
+// Copy of the GNU General Public License is in LICENSE.txt and  
+// on <http://www.gnu.org/licenses/>.
+
+#include <JtDecode_Int32CDP_MoveToFront.hxx>
+#include <algorithm>
+
+JtDecode_Int32CDP_MoveToFront::Decoded::Mover JtDecode_Int32CDP_MoveToFront::Decode()
+{
+  // Offset -1: next new value from the values stream, otherwise the position in the window
+  // of the most recently seen values; the value used moves to the front of the window.
+  static const int32_t aWindowSize = 16;
+  Decoded aValues (decodePackage (myValues));
+  Decoded aOffsets (decodePackage (myOffsets));
+  Decoded aResults (aOffsets.Count());
+  int32_t aWindow[aWindowSize];
+  int32_t aFill = 0, aNext = 0;
+  for (int32_t i = 0; i < aOffsets.Count(); i++)
+  {
+    const int32_t anOffset = aOffsets[i];
+    int32_t aValue;
+    if (anOffset < 0)
+    {
+      if (aNext >= aValues.Count())
+        return Decoded().Move();
+      aValue = aValues[aNext++];
+      aFill = std::min (aFill + 1, aWindowSize);
+      std::copy_backward (aWindow, aWindow + aFill - 1, aWindow + aFill);
+    }
+    else
+    {
+      if (anOffset >= aFill)
+        return Decoded().Move();
+      aValue = aWindow[anOffset];
+      std::copy_backward (aWindow, aWindow + anOffset, aWindow + anOffset + 1);
+    }
+    aWindow[0] = aValue;
+    aResults[i] = aValue;
+  }
+  return aResults.Move();
+}
